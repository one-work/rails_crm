<div class="is-several is-wrap">
  <%= image_tag model.avatar.variant(resize_to_limit: [24, 24]), class: 'image is-radius is-24x24' if model.avatar.attached? %>
  <span><%= model.title %></span>
</div>
<p class="size-7 text-grey">
  <time data-controller="time" data-format="human"><%= model.created_at.to_fs(:iso8601) %></time>
</p>
