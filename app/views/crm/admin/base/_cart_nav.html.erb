<div id="cart_nav" class="is-fixed-bottom box level p-3 background-light">
  <div class="level-left">
    <%= link_to({ controller: 'carts', action: 'show', id: cart.id }) do %>
      <%= svg_tag 'cart-shopping' %>
      <span class="text-danger"><%= cart.amount.to_money.format.html_safe %></span>
    <% end %>
  </div>
  <div class="level-right">
    <%= link_to({ controller: 'crm/admin/orders', action: 'cart', current_cart_id: cart.id, **params.permit!.slice('factory_taxon_id') }, class: 'button is-success') do %>
      <%= svg_tag 'credit-card' %>
      <span class="ml-1"><%= t('.orders.cart.title') %></span>
    <% end %>
  </div>
</div>
