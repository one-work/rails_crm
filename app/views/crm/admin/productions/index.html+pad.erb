<%= render 'maintain_bar' %>

<div class="columns is-gapless">
  <div class="column">
    <div class="cards is-4">
      <%=
        render(
          partial: 'production_cart',
          layout: 'card',
          collection: @productions,
          as: :model,
          locals: {
            cart: @cart,
            item_con: 'crm/admin/items',
            extra_options: { controller: controller_path },
            cart_options: { **params.permit(:dispatch, :produce_on, :scene_id, :desk_id, :station_id, :client_id, :contact_id), **session.to_h.slice('desk_id', 'station_id') }
          }
        )
      %>
    </div>
  </div>
  <div class="column is-one-quarter">
    <%= render partial: 'cart_nav', locals: { cart: @cart, cart_con: 'trade/agent/carts', order_con: 'trade/agent/orders' } %>
  </div>
</div>

<%= paginate @productions %>
