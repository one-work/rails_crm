<%= turbo_stream.replace 'page_loading' do %>
  <%=
    render(
      partial: 'production_cart',
      layout: 'production',
      collection: @productions,
      as: :model,
      locals: { cart: @cart, item_con: 'trade/agent/items', prod_con: controller_path }
    )
  %>
  <%= render partial: 'page_loading', locals: { all: @productions } %>
<% end %>
